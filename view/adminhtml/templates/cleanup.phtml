<?php
/** @var \Merlin\OfferRuleCleanup\Block\Adminhtml\Cleanup $block */
$count = $block->getExpiredCount();
$config = [
    'url' => $block->getCleanupUrl(),
    'formKey' => $block->getFormKey(),
];
?>
<div class="admin__fieldset" data-mage-init='{"Merlin_OfferRuleCleanup/js/cleanup":<?= $block->escapeHtmlAttr(json_encode($config, JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP | JSON_HEX_TAG)) ?>}'>
    <strong><?= $block->escapeHtml(__('Expired Make an Offer rules: %1', $count)) ?></strong>
    <p><?= $block->escapeHtml(__('Only expired rules generated by Make an Offer are included. Deletion also removes their coupons.')) ?></p>
    <?php if ($count): ?>
        <button type="button" class="action-secondary" data-role="cleanup-offer-rules">
            <span><?= $block->escapeHtml(__('Delete expired Make an Offer rules')) ?></span>
        </button>
    <?php endif; ?>
    <p data-role="cleanup-progress" aria-live="polite"></p>
</div>
